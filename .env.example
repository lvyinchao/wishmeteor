# Local only. Never commit values; never expose any of these to the Worker.
#
# Blessing emails go out through Cloudflare Email Service (Email Sending), whose REST
# endpoint accepts either of the credentials below. wishmeteor.net is onboarded under
# Compute > Email Service > Email Sending, and Cloudflare manages the bounce SPF/DKIM/
# DMARC records for the zone itself.

# Optional. Without it, scripts/notify.mjs falls back to the OAuth token that wrangler
# keeps in ~/Library/Preferences/.wrangler/config/default.toml — `pnpm ship` runs
# `wrangler deploy` right before sending, so that token is fresh. Set this only if you
# create a dedicated token (needs the "Email Sending: Edit" permission in the dashboard).
CF_API_TOKEN=

# Account the send endpoint is called against.
CF_ACCOUNT_ID=3c772e18744e927e0eda39ca57aac390

# Must be a local-part on an onboarded domain.
EMAIL_FROM=WishMeteor <support@wishmeteor.net>

# Optional: raises GitHub API limits from 10 search req/min to 30.
GITHUB_TOKEN=
