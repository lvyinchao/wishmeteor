---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../lib/site.ts';
import { getPublicPosts } from '../../lib/public-content.ts';

const posts = (await getPublicPosts()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const byMonth = new Map<string, typeof posts>();
for (const post of posts) {
  const key = post.data.pubDate.toISOString().slice(0, 7);
  byMonth.set(key, [...(byMonth.get(key) ?? []), post]);
}

const title = `Blog — ideas, discovery and building with care | ${SITE.name}`;
const description = `Stories and practical notes from WishMeteor about discovering AI projects, sharing a maker’s wish, and building something worth bringing into the world.`;
---

<Base title={title} description={description}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Blog' }]} />
  <div class="page-head">
    <p class="eyebrow">Notes for people building something</p>
    <h1>Blog</h1>
    <p class="lede">
      Ideas, field notes and thoughtful questions from our sky of projects. Read about the people and choices behind a launch.
    </p>
  </div>

  {
    [...byMonth.entries()].map(([month, monthPosts]) => (
      <section class="section" aria-labelledby={`m-${month}`}>
        <div class="section-head">
          <h2 id={`m-${month}`} style="font-size:1.1rem;margin:0">{month}</h2>
          <span style="color:var(--muted);font-size:.85rem">{monthPosts.length} articles</span>
        </div>
        <div class="grid">
          {monthPosts.map((post) => (
            <article class="card">
              <h3>
                <a class="card-title" href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <div class="card-meta">
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
                <span class="pill">{post.data.category}</span>
                <span>{post.data.toolRefs.length} tools referenced</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</Base>
