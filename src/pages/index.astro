---
import Base from '../layouts/Base.astro';
import ShowcaseCard from '../components/ShowcaseCard.astro';
import { inCategory, sortNewest, categoryPath } from '../lib/catalog.mjs';
import { getPublicPosts, loadPublicCatalog } from '../lib/public-content.ts';
import { SITE } from '../lib/site.ts';

const { tools, categories, errors } = loadPublicCatalog();
if (errors.length) throw new Error(`Content validation failed:\n${errors.join('\n')}`);
const categoryById = new Map(categories.map((c) => [c.id, c]));
const live = tools.filter((t) => t.status !== 'archived');
const fresh = sortNewest(live);
const posts = (await getPublicPosts()).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const title = `${SITE.name} — a wishing well for AI builders`;
const description = 'A small constellation for people building AI products. Share what you are making, receive a thoughtful blessing, and light a star for a launch you believe in.';
---

<Base title={title} description={description}>
  <section class="wish-hero" aria-labelledby="hero-title">
    <div class="wish-hero__sky" aria-hidden="true">
      <span class="sky-orbit sky-orbit--outer"></span>
      <span class="sky-orbit sky-orbit--inner"></span>
      <span class="sky-moon"></span>
      <span class="sky-star sky-star--one">✦</span><span class="sky-star sky-star--two">✧</span>
      <span class="sky-star sky-star--three">✦</span><span class="sky-star sky-star--four">✧</span>
      <span class="sky-trail"></span>
    </div>
    <div class="wish-hero__copy">
      <p class="eyebrow">A wishing well for people building AI</p>
      <h1 id="hero-title">Every brave idea deserves a little starlight.</h1>
      <p class="lede">Share what you are making. Meet kindred builders, find a spark, and help a launch rise.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#wish-wall">Explore Wish Sky <span aria-hidden="true">↓</span></a>
        <a class="btn btn-ghost" href="/submit">Share a wish <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="wish-hero__caption" aria-hidden="true"><span>WISHES IN MOTION</span><span>✦</span><span>MADE WITH HOPE</span></div>
  </section>

  <section class="section recently-section catalog-section wish-sky-catalog" id="wish-wall" aria-labelledby="wish-sky-title" data-catalog>
    <div class="section-head">
      <div><p class="eyebrow">A little light goes a long way</p><h2 id="wish-sky-title">A project worth a little starlight</h2><p class="section-intro">Explore approved projects, find a spark, and light a star.</p></div>
      <a class="text-link" href="#catalog-grid">Browse the wish sky <span aria-hidden="true">↓</span></a>
    </div>
    <div class="catalog-controls">
      <label class="catalog-search" for="catalog-search">
        <span aria-hidden="true">⌕</span>
        <input id="catalog-search" type="search" aria-label="Search products by name, keyword, category, or description" placeholder="Search by name, keyword, or description" autocomplete="off" />
        <kbd>⌘ K</kbd>
      </label>
      <div class="catalog-filters" data-catalog-filters role="group" aria-label="Filter products by category">
        <button class="catalog-filter is-active" type="button" data-category-filter="all" aria-pressed="true">All products <span>{fresh.length}</span></button>
        {categories.map((category) => {
          const count = inCategory(fresh, category.id).length;
          return count ? <button class="catalog-filter" type="button" data-category-filter={category.id} aria-pressed="false">{category.name} <span>{count}</span></button> : null;
        })}
      </div>
    </div>
    <p class="catalog-results" data-catalog-results role="status" aria-live="polite">{fresh.length} products · 12 per page</p>
    <div class="grid grid-cards" id="catalog-grid" data-catalog-grid>
      {fresh.map((entry) => <ShowcaseCard entry={entry} categoryName={categoryById.get(entry.category)?.name ?? entry.category} />)}
    </div>
    <p class="catalog-empty" data-catalog-empty hidden>No products match this search. Try another keyword or category.</p>
    <nav class="catalog-pagination" data-catalog-pagination aria-label="Wish sky pages"></nav>
    <p class="wish-wall__note" data-star-status role="status" aria-live="polite">Each person can light one star for a project. The brightest wishes find their way upward.</p>
  </section>

  <section class="welcome-strip" aria-label="Our promise">
    <div><span class="welcome-mark">01</span><p><strong>Make room for the dream</strong><br />A home for the AI products people care enough to build.</p></div>
    <div><span class="welcome-mark">02</span><p><strong>Leave a little light</strong><br />Every launch can carry a blessing from its maker.</p></div>
    <div><span class="welcome-mark">03</span><p><strong>Help a wish travel</strong><br />Light a star to lift a founder's work into view.</p></div>
  </section>

  <section class="section constellation-section" aria-labelledby="constellations">
    <div class="section-head">
      <div><p class="eyebrow">Find your corner of the sky</p><h2 id="constellations">What are you dreaming up?</h2></div>
      <a class="text-link" href="/tools">Wander through the projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="constellation-grid">
      {categories.map((category, index) => {
        const count = inCategory(live, category.id).length;
        return <a class="constellation" href={categoryPath(category.id)}>
          <span class="constellation__index">{String(index + 1).padStart(2, '0')}</span>
          <span class="constellation__content"><strong>{category.name}</strong><small>{category.description}</small></span>
          <span class="constellation__count" aria-label={`${count} projects`}>{count}<span aria-hidden="true"> ↗</span></span>
        </a>;
      })}
    </div>
  </section>


  <script is:inline>
    (() => {
      const catalog = document.querySelector('[data-catalog]');
      const grid = catalog?.querySelector('[data-catalog-grid]');
      const search = catalog?.querySelector('#catalog-search');
      const filters = catalog?.querySelector('[data-catalog-filters]');
      const results = catalog?.querySelector('[data-catalog-results]');
      const empty = catalog?.querySelector('[data-catalog-empty]');
      const pagination = catalog?.querySelector('[data-catalog-pagination]');
      if (!grid || !search || !filters || !results || !empty || !pagination) return;

      const cards = Array.from(grid.querySelectorAll('[data-catalog-item]'));
      const status = catalog.querySelector('[data-star-status]');
      const starKey = (slug) => `wishmeteor:star:${slug}`;
      const hydrateStars = async (visible) => {
        const slugs = visible.map((card) => card.dataset.slug).filter(Boolean);
        if (!slugs.length) return;
        try {
          const response = await fetch(`/api/stars?slugs=${encodeURIComponent(slugs.join(','))}`);
          if (!response.ok) throw new Error();
          const data = await response.json();
          visible.forEach((card) => {
            const slug = card.dataset.slug;
            card.querySelector('[data-star-count]').textContent = String(data.counts?.[slug] ?? 0);
            const button = card.querySelector('[data-star-button]');
            if (localStorage.getItem(starKey(slug))) { button.setAttribute('aria-pressed', 'true'); button.disabled = true; button.querySelector('[data-star-label]').textContent = 'Your star is lit'; }
          });
        } catch { visible.forEach((card) => { card.querySelector('[data-star-count]').textContent = '☆'; }); }
      };
      const makeVoter = () => { try { let id = localStorage.getItem('wishmeteor:voter'); if (!id) { id = crypto.randomUUID(); localStorage.setItem('wishmeteor:voter', id); } return id; } catch { return ''; } };
      grid.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-star-button]');
        if (!button) return;
        const card = button.closest('[data-catalog-item]');
        const voter = makeVoter();
        if (!voter) { if (status) status.textContent = 'Your browser storage is unavailable, so we could not save your star.'; return; }
        button.disabled = true;
        try {
          const response = await fetch('/api/stars', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug: card.dataset.slug, voter }) });
          if (!response.ok) throw new Error();
          const result = await response.json();
          localStorage.setItem(starKey(card.dataset.slug), '1');
          button.setAttribute('aria-pressed', 'true');
          button.querySelector('[data-star-count]').textContent = String(result.count);
          button.querySelector('[data-star-label]').textContent = 'Your star is lit';
          if (status) status.textContent = 'Your star reached the sky. Thank you for the encouragement.';
        } catch { button.disabled = false; if (status) status.textContent = 'Your star did not reach the sky. Please try again in a moment.'; }
      });
      const pageSize = 12;
      let activeCategory = 'all';
      let currentPage = 1;

      const matchingCards = () => {
        const query = search.value.trim().toLowerCase();
        return cards.filter((card) => {
          const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
          const textMatch = !query || (card.dataset.search || '').includes(query);
          return categoryMatch && textMatch;
        });
      };

      const changePage = (page, pageCount) => {
        currentPage = Math.min(Math.max(page, 1), Math.max(pageCount, 1));
        render();
      };

      const render = () => {
        const matched = matchingCards();
        const pageCount = Math.max(1, Math.ceil(matched.length / pageSize));
        currentPage = Math.min(currentPage, pageCount);
        const start = (currentPage - 1) * pageSize;
        const shown = new Set(matched.slice(start, start + pageSize));
        cards.forEach((card) => { card.hidden = !shown.has(card); });
        void hydrateStars([...shown]);
        results.textContent = `${matched.length ? `${start + 1}–${Math.min(start + pageSize, matched.length)} of ` : ''}${matched.length} products`;
        empty.hidden = matched.length > 0;

        pagination.replaceChildren();
        if (pageCount <= 1) return;
        const addButton = (label, page, { current = false, disabled = false, ariaLabel } = {}) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = `catalog-page${current ? ' is-current' : ''}`;
          button.textContent = label;
          button.disabled = disabled;
          if (current) button.setAttribute('aria-current', 'page');
          if (ariaLabel) button.setAttribute('aria-label', ariaLabel);
          button.addEventListener('click', () => changePage(page, pageCount));
          pagination.append(button);
        };
        addButton('←', currentPage - 1, { disabled: currentPage === 1, ariaLabel: 'Previous page' });
        const pages = pageCount <= 7
          ? Array.from({ length: pageCount }, (_, index) => index + 1)
          : [...new Set([1, Math.max(2, currentPage - 1), currentPage, Math.min(pageCount - 1, currentPage + 1), pageCount])].sort((a, b) => a - b);
        let previous = 0;
        pages.forEach((page) => {
          if (page - previous > 1) {
            const gap = document.createElement('span');
            gap.className = 'catalog-page-gap';
            gap.textContent = '…';
            pagination.append(gap);
          }
          addButton(String(page), page, { current: page === currentPage, ariaLabel: `Page ${page}` });
          previous = page;
        });
        addButton('→', currentPage + 1, { disabled: currentPage === pageCount, ariaLabel: 'Next page' });
      };

      search.addEventListener('input', () => { currentPage = 1; render(); });
      filters.addEventListener('click', (event) => {
        const button = event.target.closest('[data-category-filter]');
        if (!button) return;
        activeCategory = button.dataset.categoryFilter;
        filters.querySelectorAll('[data-category-filter]').forEach((item) => {
          item.setAttribute('aria-pressed', String(item === button));
        });
        currentPage = 1;
        render();
      });
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          search.focus();
        }
      });
      render();
    })();
  </script>

  {posts.length > 0 && <section class="section logbook-section" aria-labelledby="writing">
    <div class="section-head"><div><p class="eyebrow">Notes from our night sky</p><h2 id="writing">The logbook</h2></div><a class="text-link" href="/blog">Read the logbook <span aria-hidden="true">↗</span></a></div>
    <div class="grid grid-cards">
      {posts.slice(0, 3).map((post) => <article class="card logbook-card"><p class="eyebrow">{post.data.category}</p><h3><a class="card-title" href={`/blog/${post.id}`}>{post.data.title}</a></h3><p>{post.data.description}</p><time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toISOString().slice(0, 10)}</time></article>)}
    </div>
  </section>}

  <section class="closing-wish" aria-labelledby="closing-title">
    <span class="closing-wish__spark" aria-hidden="true">✦</span><div><p class="eyebrow">There is room for one more</p><h2 id="closing-title">What are you hoping to bring to life?</h2><p>Put your idea beneath this sky. Let the next chapter begin with a wish.</p></div><a class="btn btn-primary" href="/submit">Plant a wish <span aria-hidden="true">↗</span></a>
  </section>
</Base>
