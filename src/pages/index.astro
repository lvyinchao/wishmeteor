---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import WishWall from '../components/WishWall.astro';
import { loadCatalog, inCategory, launchedWishes, sortNewest, categoryPath, toolPath } from '../lib/catalog.mjs';
import { SITE } from '../lib/site.ts';

const { tools, categories, errors } = loadCatalog();
if (errors.length) throw new Error(`Content validation failed:\n${errors.join('\n')}`);

const categoryById = new Map(categories.map((c) => [c.id, c]));
const live = tools.filter((t) => t.status !== 'archived');
const wishes = launchedWishes(live, 12);
const fresh = sortNewest(live.filter((t) => t.origin === 'curated')).slice(0, 12);
const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `${SITE.name} — AI tools index with a free dofollow backlink for founders`;
const description =
  'Submit your AI tool, model or open-source project and, once it clears review, it goes live with a dofollow backlink and a hand-written blessing. Sixty curated entries across ten categories.';
---

<Base
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      url: SITE.url,
      description: SITE.description,
      inLanguage: 'en',
    },
  ]}
>
  <section class="hero">
    <div class="meteor-field" aria-hidden="true">
      <span class="streak" style="top:34%;left:78%"></span>
      <span class="streak"></span>
      <span class="streak"></span>
      <span class="streak"></span>
    </div>
    <p class="eyebrow">AI tools · models · open source</p>
    <h1>Make a wish. Get a real dofollow backlink.</h1>
    <p class="lede">
      {SITE.name} indexes the tools people actually ship with — and when you launch your own product here, the link stays
      dofollow for as long as it stays live. Every approved wish also gets a blessing written by hand, sent to your inbox and
      printed on the entry.
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="/submit">Make a wish — free</a>
      <a class="btn btn-ghost" href="/free-dofollow-backlinks">How the links work</a>
    </div>
  </section>

  <WishWall entries={wishes} />

  <section class="section" aria-labelledby="categories">
    <div class="section-head">
      <h2 id="categories">Ten categories</h2>
      <a href="/tools">Browse all {live.length} entries</a>
    </div>
    <div class="grid grid-cats">
      {
        categories.map((category) => {
          const count = inCategory(live, category.id).length;
          return (
            <a class="card" href={categoryPath(category.id)} style="text-decoration:none">
              <h3>{category.name}</h3>
              <p>{category.description}</p>
              <div class="card-meta">
                <span class="pill">{count} entries</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="section" aria-labelledby="fresh">
    <div class="section-head">
      <h2 id="fresh">Recently indexed</h2>
      <a href="/blog">Read the blog</a>
    </div>
    <div class="grid grid-cards">
      {fresh.map((entry) => (
        <ToolCard entry={entry} categoryName={categoryById.get(entry.category)?.name ?? entry.category} />
      ))}
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section" aria-labelledby="writing">
        <div class="section-head">
          <h2 id="writing">From the logbook</h2>
          <a href="/blog">All articles</a>
        </div>
        <div class="grid grid-cards">
          {posts.slice(0, 3).map((post) => (
            <article class="card">
              <h3>
                <a class="card-title" href={`/blog/${post.id}`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              <div class="card-meta">
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
                <span class="pill">{post.data.category}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }
</Base>
