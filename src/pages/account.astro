---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Your account — WishMeteor';
const description = 'Sign in or create a WishMeteor account with Google or email.';
---

<Base title={title} description={description} noindex>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Your account' }]} />
  <section class="account-page">
    <div class="account-page__intro">
      <span class="eyebrow">A place among the stars</span>
      <h1>Your WishMeteor account</h1>
      <p class="lede">Sign in to keep your place here. A verified email helps us protect your account.</p>
    </div>

    <div class="account-card" data-account-card>
      <div data-account-form-view>
        <div class="account-card__google" data-google-area hidden>
          <div id="google-signin-button"></div>
          <p class="account-divider"><span>or continue with email</span></p>
        </div>

        <div class="account-tabs" role="tablist" aria-label="Account action">
          <button class="account-tab is-active" id="mode-login" type="button" role="tab" aria-selected="true">Sign in</button>
          <button class="account-tab" id="mode-register" type="button" role="tab" aria-selected="false">Create account</button>
        </div>

        <form class="account-form" id="account-form">
          <label for="account-email">Email address</label>
          <input id="account-email" name="email" type="email" autocomplete="email" required maxlength="254" />
          <label for="account-password">Password</label>
          <input id="account-password" name="password" type="password" autocomplete="current-password" required minlength="1" maxlength="256" />
          <p class="account-form__hint" data-password-hint hidden>Use at least 8 characters.</p>
        <button class="btn btn-primary account-submit" type="submit" data-submit>Sign in</button>
        </form>
        <div class="account-recovery-actions"><button class="btn btn-quiet" type="button" data-resend>Resend verification</button><button class="btn btn-quiet" type="button" data-reset-request>Forgot password?</button></div>
        <form class="account-form" data-reset-form hidden><h2>Set a new password</h2><label>New password<input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="256" /></label><label>Confirm password<input name="confirmation" type="password" autocomplete="new-password" required minlength="8" maxlength="256" /></label><button class="btn btn-primary" type="submit">Save new password</button></form>
        <p class="account-message" data-account-message role="status" aria-live="polite"></p>
        <p class="account-legal">We use your email for account access and essential service messages. Read our <a href="/privacy">privacy details</a>.</p>
      </div>

      <div data-account-signed-in hidden>
        <span class="eyebrow">Welcome back</span>
        <h2 data-account-name></h2>
        <p class="section-intro" data-account-email></p>
        <section class="account-submissions" aria-labelledby="submission-heading">
          <div class="account-submissions__heading">
            <h3 id="submission-heading">Your product submissions</h3>
            <a class="btn btn-quiet account-submissions__new" href="/submit">Submit another</a>
          </div>
          <p data-submissions-empty>No product submissions yet. Share your project whenever you are ready.</p>
          <ul data-submission-list></ul>
          <p class="account-form__hint" data-submissions-error hidden>Submission status could not be loaded. Please refresh to try again.</p>
        </section>
        <section class="account-projects"><h3>Saved and followed projects</h3><ul data-project-list></ul><p data-project-list-status role="status"></p></section>
        <div class="account-recovery-actions"><button class="btn btn-quiet" type="button" data-password-setup>Reset or add a password</button><button class="btn btn-quiet" type="button" data-revoke>Sign out all sessions</button></div><button class="btn btn-quiet" type="button" data-connect-google>Connect Google</button><div data-google-connect-area hidden><div id="google-connect-button"></div></div><p data-security-status role="status"></p>
      </div>
    </div>
    <p class="account-footnote">Connect sign-in methods using an existing account credential and a verified email.</p>
  </section>
</Base>

<script>
  interface AccountInfo { id: string; email: string; name: string }
  interface SubmissionInfo { id: number; name: string; url: string; email: string | null; category: string; notes: string; make_a_wish: string; created_at: string; verdict: 'pending' | 'approved' | 'rejected'; verdict_at: string | null; slug: string | null; notification_state: string | null }
  interface GoogleCredentialResponse { credential: string }
  interface GoogleApi {
    accounts: {
      id: {
        initialize(options: { client_id: string; nonce: string; callback: (response: GoogleCredentialResponse) => void; context: 'signin'; use_fedcm_for_prompt: true }): void;
        renderButton(parent: HTMLElement, options: { theme: 'outline'; size: 'large'; shape: 'pill'; text: 'signin_with'; width: number }): void;
        prompt(): void;
      };
    };
  }
  declare global { interface Window { google?: GoogleApi } }

  const formView = document.querySelector<HTMLElement>('[data-account-form-view]');
  const signedInView = document.querySelector<HTMLElement>('[data-account-signed-in]');
  const message = document.querySelector<HTMLElement>('[data-account-message]');
  const form = document.querySelector<HTMLFormElement>('#account-form');
  const password = document.querySelector<HTMLInputElement>('#account-password');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');
  const googleArea = document.querySelector<HTMLElement>('[data-google-area]');
  let mode: 'login' | 'register' = 'login';
  let busy = false;
  let currentEmail = '';
  const resetToken = new URLSearchParams(location.search).get('reset');
  if (resetToken) { history.replaceState(null,'','/account'); document.querySelector<HTMLFormElement>('[data-reset-form]')!.hidden=false; if(form)form.hidden=true; document.querySelector<HTMLElement>('.account-tabs')!.hidden=true; document.querySelector<HTMLElement>('.account-recovery-actions')!.hidden=true; }

  function setMessage(text: string, kind: 'info' | 'error' | 'success' = 'info') {
    if (!message) return;
    message.textContent = text;
    message.dataset.kind = kind;
  }

  function showAccount(account: AccountInfo) {
    currentEmail=account.email;
    if(password)password.value='';
    if (formView) formView.hidden = true;
    if (signedInView) signedInView.hidden = false;
    const name = signedInView?.querySelector<HTMLElement>('[data-account-name]');
    const email = signedInView?.querySelector<HTMLElement>('[data-account-email]');
    if (name) name.textContent = account.name ? `Welcome, ${account.name}` : 'Welcome to the wish sky';
    if (email) email.textContent = account.email;
    window.dispatchEvent(new CustomEvent('wishmeteor:account', { detail: account }));
    void loadSubmissions();
    void loadProjects();
  }

  async function loadSubmissions() {
    const list = signedInView?.querySelector<HTMLUListElement>('[data-submission-list]');
    const empty = signedInView?.querySelector<HTMLElement>('[data-submissions-empty]');
    const error = signedInView?.querySelector<HTMLElement>('[data-submissions-error]');
    if (!list || !empty || !error) return;
    try {
      const response = await fetch('/api/account/submissions', { credentials: 'same-origin' });
      if (!response.ok) throw new Error('submissions-unavailable');
      const result = await response.json() as { submissions?: SubmissionInfo[] };
      const submissions = result.submissions ?? [];
      list.replaceChildren(...submissions.map((submission) => {
        const item = document.createElement('li');
        item.className = 'submission-card';
        const title = document.createElement('strong');
        title.textContent = submission.name;
        const state = document.createElement('span');
        state.className = `submission-state submission-state--${submission.verdict}`;
        state.textContent = submission.verdict === 'pending' ? 'Under review' : submission.verdict === 'approved' ? (submission.slug?'Published':'Reviewed; listing not public') : 'Not accepted';
        const date = document.createElement('time');
        date.dateTime = submission.created_at;
        date.textContent = `Submitted ${new Date(submission.created_at).toLocaleDateString()}`;
        const link = document.createElement('a');
        link.href = submission.url;
        link.textContent = submission.url;
        link.rel = 'noopener noreferrer';
        const meta = document.createElement('div');
        meta.className = 'submission-card__meta';
        meta.append(date);
        const delivery=document.createElement('span'); delivery.textContent=`Service notification: ${submission.notification_state ?? 'not queued'}`; meta.append(delivery);
        if(submission.slug) { const published=document.createElement('a');published.href=`/tool/${submission.slug}`;published.textContent='View published listing and blessing';meta.append(published); }
        if (submission.verdict_at) {
          const reviewed = document.createElement('time');
          reviewed.dateTime = submission.verdict_at;
          reviewed.textContent = `Updated ${new Date(submission.verdict_at).toLocaleDateString()}`;
          meta.append(reviewed);
        }
        const content = document.createElement('div');
        content.className = 'submission-card__content';
        const category = document.createElement('p');
        category.textContent = `Category: ${submission.category || 'Not specified'}`;
        const contact = document.createElement('p');
        contact.textContent = `Blessing email: ${submission.email || 'Not provided'}`;
        const urlLine = document.createElement('p');
        urlLine.append(document.createTextNode('Link: '), link);
        content.append(category, contact, urlLine);
        if (submission.notes) {
          const notes = document.createElement('p');
          notes.textContent = `About the project: ${submission.notes}`;
          content.append(notes);
        }
        if (submission.make_a_wish) {
          const wish = document.createElement('p');
          wish.textContent = `Your wish: ${submission.make_a_wish}`;
          content.append(wish);
        }
        const controls = document.createElement('div');
        controls.className = 'submission-card__actions';
        const feedback = document.createElement('p');
        feedback.className = 'submission-card__message';
        feedback.setAttribute('role', 'status');
        feedback.setAttribute('aria-live', 'polite');
        if (submission.verdict === 'pending') {
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'btn btn-quiet';
          edit.textContent = 'Edit';
          const withdraw = document.createElement('button');
          withdraw.type = 'button';
          withdraw.className = 'btn btn-quiet submission-card__withdraw';
          withdraw.textContent = 'Withdraw';
          controls.append(edit, withdraw);
          const editor = document.createElement('form');
          editor.className = 'submission-edit';
          editor.hidden = true;
          const fields: Array<[string, string, string, number]> = [
            ['name', 'Product name', submission.name, 80],
            ['url', 'Link', submission.url, 2048],
            ['email', 'Email for your blessing', submission.email ?? '', 254],
            ['category', 'Category', submission.category, 40],
          ];
          for (const [key, labelText, value, maxLength] of fields) {
            const label = document.createElement('label');
            label.textContent = labelText;
            const input = document.createElement('input');
            input.name = key;
            input.value = value;
            input.maxLength = maxLength;
            input.required = true;
            if (key === 'url') input.type = 'url';
            if (key === 'email') input.type = 'email';
            label.append(input);
            editor.append(label);
          }
          for (const [key, labelText, value, maxLength] of [
            ['notes', 'What it does', submission.notes, 600],
            ['makeAWish', 'Make a wish', submission.make_a_wish, 320],
          ] as Array<[string, string, string, number]>) {
            const label = document.createElement('label');
            label.textContent = labelText;
            const area = document.createElement('textarea');
            area.name = key;
            area.value = value;
            area.maxLength = maxLength;
            area.rows = key === 'notes' ? 4 : 3;
            label.append(area);
            editor.append(label);
          }
          const save = document.createElement('button');
          save.type = 'submit';
          save.className = 'btn btn-primary';
          save.textContent = 'Save changes';
          const cancel = document.createElement('button');
          cancel.type = 'button';
          cancel.className = 'btn btn-quiet';
          cancel.textContent = 'Cancel';
          const editActions = document.createElement('div');
          editActions.className = 'submission-card__actions';
          editActions.append(save, cancel);
          editor.append(editActions);
          edit.addEventListener('click', () => { editor.hidden = !editor.hidden; feedback.textContent = ''; });
          cancel.addEventListener('click', () => { editor.hidden = true; feedback.textContent = ''; });
          editor.addEventListener('submit', async (event) => {
            event.preventDefault();
            const payload = Object.fromEntries(new FormData(editor).entries());
            save.disabled = true;
            feedback.textContent = 'Saving your changes…';
            try {
              const changed = await fetch(`/api/account/submissions/${submission.id}`, {
                method: 'PATCH', credentials: 'same-origin',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(payload),
              });
              const data = await changed.json().catch(() => ({})) as { error?: string };
              if (!changed.ok) throw new Error(data.error ?? 'save-failed');
              await loadSubmissions();
            } catch (error) {
              const code = error instanceof Error ? error.message : '';
              feedback.textContent = code === 'duplicate' ? 'Another submission or listed product already uses that product identity.' : code === 'submission-busy-or-locked' ? 'A service message is being sent, or this submission was reviewed. Refresh and try again.' : code === 'submission-locked' ? 'This submission has already been reviewed and can no longer be changed.' : 'We could not save those changes. Check the details and try again.';
            } finally { save.disabled = false; }
          });
          withdraw.addEventListener('click', async () => {
            if (!window.confirm(`Withdraw “${submission.name}” from review? This removes the submission from your queue.`)) return;
            withdraw.disabled = true;
            feedback.textContent = 'Withdrawing your submission…';
            try {
              const removed = await fetch(`/api/account/submissions/${submission.id}`, { method: 'DELETE', credentials: 'same-origin' });
              const data = await removed.json().catch(() => ({})) as { error?: string };
              if (!removed.ok) throw new Error(data.error ?? 'withdraw-failed');
              await loadSubmissions();
            } catch (error) {
              const code = error instanceof Error ? error.message : '';
              feedback.textContent = code === 'submission-locked' ? 'This submission has already been reviewed and can no longer be withdrawn.' : 'We could not withdraw the submission. Please try again.';
              withdraw.disabled = false;
            }
          });
          item.append(title, state, meta, content, controls, editor, feedback);
        } else {
          item.append(title, state, meta, content);
        }
        return item;
      }));
      empty.hidden = submissions.length !== 0;
      error.hidden = true;
    } catch {
      empty.hidden = true;
      error.hidden = false;
    }
  }

  function setMode(next: 'login' | 'register') {
    mode = next;
    const registering = next === 'register';
    document.querySelector('#mode-login')?.classList.toggle('is-active', !registering);
    document.querySelector('#mode-register')?.classList.toggle('is-active', registering);
    document.querySelector('#mode-login')?.setAttribute('aria-selected', String(!registering));
    document.querySelector('#mode-register')?.setAttribute('aria-selected', String(registering));
    if (password) password.autocomplete = registering ? 'new-password' : 'current-password';
    if (password) password.minLength = registering ? 8 : 1;
    const hint = document.querySelector<HTMLElement>('[data-password-hint]');
    if (hint) hint.hidden = !registering;
    if (submit) submit.textContent = registering ? 'Create account' : 'Sign in';
    setMessage('');
  }

  document.querySelector('#mode-login')?.addEventListener('click', () => setMode('login'));
  document.querySelector('#mode-register')?.addEventListener('click', () => setMode('register'));

  function errorText(code: string): string {
    const messages: Record<string, string> = {
      'invalid-input': 'Enter a valid email and a password with at least 8 characters.',
      'invalid-credentials': 'That email and password combination could not be verified.',
      'account-exists': 'An account already uses this email. Sign in or choose Google.',
      'email-not-verified': 'Please verify your email first. Use Resend verification if the link expired.',
      'email-unavailable': 'The verification email could not be sent right now. Please try again shortly.',
      'try-later': 'Too many attempts. Please wait a little and try again.',
      'google-not-configured': 'Google sign-in is being set up. Use your email for now.',
      'google-unavailable': 'Google sign-in is temporarily unavailable. Please try again.',
      'account-conflict': 'This Google account is already linked to another account.',
      'account-link-credential-required': 'Enter your existing password, then choose Google again to connect it.',
      'invalid-reset': 'This password link is invalid or expired. Request a new password link.',
    };
    return messages[code] ?? 'We could not complete that request. Please try again.';
  }

  async function request(path: string, payload?: Record<string, string>): Promise<{ ok: boolean; status: number; data: Record<string, unknown> }> {
    const response = await fetch(path, {
      method: payload ? 'POST' : 'GET',
      headers: payload ? { 'content-type': 'application/json' } : {},
      body: payload ? JSON.stringify(payload) : undefined,
      credentials: 'same-origin',
    });
    const data = await response.json().catch(() => ({})) as Record<string, unknown>;
    return { ok: response.ok, status: response.status, data };
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy) return;
    const values = new FormData(form);
    const email = String(values.get('email') ?? '').trim();
    const passwordValue = String(values.get('password') ?? '');
    if (mode === 'register' && passwordValue.length < 8) {
      setMessage('Choose a password with at least 8 characters.', 'error');
      return;
    }
    busy = true;
    if (submit) { submit.disabled = true; submit.textContent = mode === 'register' ? 'Sending verification…' : 'Signing in…'; }
    setMessage('');
    try {
      const result = await request(`/api/auth/${mode}`, { email, password: passwordValue });
      if (!result.ok) {
        setMessage(errorText(String(result.data.error ?? 'unknown')), 'error');
      } else if (mode === 'register') {
        setMessage('Check your inbox for a verification link. It will be valid for 24 hours.', 'success');
        form.reset();
      } else {
        showAccount(result.data.account as AccountInfo);
      }
    } catch {
      setMessage('Connection trouble. Please try again.', 'error');
    } finally {
      busy = false;
      if (submit) {
        submit.disabled = false;
        submit.textContent = mode === 'register' ? 'Create account' : 'Sign in';
      }
    }
  });

  async function startGoogle(connect=false) {
    if (!googleArea || resetToken) return;
    const current = await request('/api/auth/me');
    if (current.data.account && !connect) {
      showAccount(current.data.account as AccountInfo);
      return;
    }
    const configResponse = await fetch('/api/auth/config', { credentials: 'same-origin' });
    if (!configResponse.ok) return;
    const config = await configResponse.json() as { googleClientId?: string; nonce?: string };
    if (!config.googleClientId || !config.nonce) return;
    const loadScript = () => {
      if (!window.google) { window.setTimeout(loadScript, 100); return; }
      const area=connect?document.querySelector<HTMLElement>('[data-google-connect-area]'):googleArea;
      if(area)area.hidden=false;
      window.google.accounts.id.initialize({
        client_id: config.googleClientId ?? '',
        nonce: config.nonce ?? '',
        context: 'signin',
        use_fedcm_for_prompt: true,
        callback: async ({ credential }) => {
          const status=connect?document.querySelector<HTMLElement>('[data-security-status]'):message;
          if(status)status.textContent='Connecting your Google account…';
          try {
            const result = await request('/api/auth/google', { credential, ...(password?.value ? {password:password.value} : {}) });
            if (!result.ok) {if(status)status.textContent=errorText(String(result.data.error ?? 'unknown'));}
            else if(result.data.account) {showAccount(result.data.account as AccountInfo);if(connect&&status)status.textContent='Google sign-in is connected.';}
            else setMessage('Check your inbox to confirm your email before signing in.','success');
          } catch {
            setMessage('Connection trouble. Please try again.', 'error');
          }
        },
      });
      const button = document.querySelector<HTMLElement>(connect?'#google-connect-button':'#google-signin-button');
      if (button) window.google.accounts.id.renderButton(button, { theme: 'outline', size: 'large', shape: 'pill', text: 'signin_with', width: Math.min(360, Math.max(240, Math.round(button.getBoundingClientRect().width))) });
      window.google.accounts.id.prompt();
    };
    const script = document.createElement('script');
    script.src = 'https://accounts.google.com/gsi/client';
    script.async = true;
    script.defer = true;
    script.onload = loadScript;
    script.onerror = () => setMessage('Google sign-in could not load. Use the email form instead.', 'error');
    if(window.google)loadScript();else document.head.append(script);
  }

  const result = new URLSearchParams(window.location.search).get('verified');
  if (result === 'success') setMessage('Your email is verified. You can sign in now.', 'success');
  else if (result === 'expired') setMessage('That verification link has expired. Use Resend verification to send a fresh link.', 'error');
  else if (result === 'invalid') setMessage('That verification link is not valid.', 'error');

  if(!resetToken) request('/api/auth/me').then(({ data }) => {
    if (data.account) showAccount(data.account as AccountInfo);
    else void startGoogle().catch(() => setMessage('Google sign-in could not load. Use the email form instead.', 'error'));
  }).catch(() => setMessage('Account status could not be loaded. You can still try signing in.', 'error'));

  async function requestEmailAction(path:string,email:string,status:HTMLElement|null) {
    if(!email) { if(status)status.textContent='Enter your email address first.'; return; }
    try { const result=await request(path,{email});if(status)status.textContent=result.ok?'If this email is eligible, an email link has been queued. Please check your inbox.':errorText(String(result.data.error)); }
    catch { if(status)status.textContent='The request could not be completed. Please try again.'; }
  }
  document.querySelector('[data-resend]')?.addEventListener('click',()=>requestEmailAction('/api/auth/resend',document.querySelector<HTMLInputElement>('#account-email')?.value ?? '',message));
  document.querySelector('[data-reset-request]')?.addEventListener('click',()=>requestEmailAction('/api/auth/reset/request',document.querySelector<HTMLInputElement>('#account-email')?.value ?? '',message));
  document.querySelector('[data-connect-google]')?.addEventListener('click',()=>startGoogle(true).catch(()=>{const status=document.querySelector('[data-security-status]');if(status)status.textContent='Google sign-in could not load. Please try again.';}));
  document.querySelector('[data-password-setup]')?.addEventListener('click',()=>requestEmailAction('/api/auth/reset/request',currentEmail,document.querySelector('[data-security-status]')));
  document.querySelector('[data-revoke]')?.addEventListener('click',async()=>{const response=await request('/api/auth/sessions/revoke',{});if(response.ok)location.reload();});
  const resetForm=document.querySelector<HTMLFormElement>('[data-reset-form]');
  resetForm?.addEventListener('submit',async event=>{
    event.preventDefault();const data=new FormData(resetForm);const value=String(data.get('password') ?? '');
    if(value!==data.get('confirmation')){setMessage('The two passwords must match.','error');return;}
    const button=resetForm.querySelector<HTMLButtonElement>('button')!;button.disabled=true;
    try{const result=await request('/api/auth/reset/complete',{token:resetToken ?? '',password:value});if(result.ok){setMessage('Your password was updated and all previous sessions were signed out. You can sign in now.','success');resetForm.hidden=true;if(form)form.hidden=false;document.querySelector<HTMLElement>('.account-tabs')!.hidden=false;}else setMessage(errorText(String(result.data.error)),'error');}
    catch{setMessage('Your password could not be updated. Please try again.','error');}finally{button.disabled=false;}
  });
  async function loadProjects() {
    const list=document.querySelector<HTMLUListElement>('[data-project-list]'),status=document.querySelector<HTMLElement>('[data-project-list-status]');if(!list||!status)return;
    try {
      const response=await fetch('/api/account/projects');if(!response.ok)throw new Error();
      const data=await response.json() as {projects:Array<{tool:{slug:string;name:string};bookmarked:boolean;following:boolean}>};
      list.replaceChildren(...data.projects.map(project=>{const item=document.createElement('li'),link=document.createElement('a');link.href=`/tool/${project.tool.slug}`;link.textContent=project.tool.name;const state=document.createElement('span');state.textContent=` — ${project.bookmarked?'Saved':''}${project.bookmarked&&project.following?' · ':''}${project.following?'Following':''}`;item.append(link,state);return item;}));status.textContent=data.projects.length?'':'No saved or followed projects yet. Explore the directory to add one.';
    }catch{status.textContent='Saved projects could not be loaded.';}
  }
  const tabs=[...document.querySelectorAll<HTMLButtonElement>('.account-tab')];
  tabs.forEach((tab,index)=>tab.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?1:1-index;tabs[next].focus();tabs[next].click();}}));
</script>
