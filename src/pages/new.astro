---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCard from '../components/ToolCard.astro';
import { sortNewest, inCategory } from '../lib/catalog.mjs';
import { loadPublicCatalog } from '../lib/public-content.ts';
import { SITE } from '../lib/site.ts';

const { tools, categories, errors } = loadPublicCatalog();
if (errors.length) throw new Error(`Content validation failed:\n${errors.join('\n')}`);
const live = tools.filter((t) => t.status !== 'archived');
const recent = sortNewest(live).slice(0, 60);
const nameOf = (id: string) => categories.find((c) => c.id === id)?.name ?? id;

const title = `Fresh wishes and discoveries | ${SITE.name}`;
const description = `Meet the latest wishes to reach the sky and thoughtful AI projects recently added to ${SITE.name}.`;
---

<Base title={title} description={description}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Wish sky', path: '/new' }, { name: 'Fresh wishes' }]} />
  <div class="page-head">
    <p class="eyebrow">A living sky of ideas</p>
    <h1>Fresh wishes &amp; discoveries</h1>
    <p class="lede">
      New wishes that have found their place alongside projects we have recently discovered. Follow a spark into a new corner of AI.
    </p>
  </div>

  <div class="grid grid-cards">
    {recent.map((entry) => <ToolCard entry={entry} categoryName={nameOf(entry.category)} />)}
  </div>

  <p style="margin-top:2rem">
    Looking for one kind of tool? <a href="/tools">The full index</a> is paginated, and each category page carries its own
    introduction:
    {' '}
    {categories.map((category, index) => (
      <>
        {index > 0 && ', '}
        <a href={`/category/${category.id}`}>{category.name}</a> ({inCategory(live, category.id).length})
      </>
    ))}
    .
  </p>
</Base>
