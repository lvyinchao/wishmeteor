---
import Base from '../layouts/Base.astro';
import { CATEGORY_NAMES } from '../lib/tool-schema.ts';
---
<Base title="Review workbench — WishMeteor" description="Review submissions, edit blessings and inspect delivery status." noindex>
 <section class="admin-workbench">
  <p class="eyebrow">Community operations</p><h1>Review workbench</h1>
  <form data-admin-login class="account-form"><label>Admin access token<input name="token" type="password" autocomplete="off" required minlength="32" maxlength="256" /></label><button type="submit" class="btn btn-primary">Open workbench</button><p class="section-intro">Access lasts one hour on this browser. The token is not saved in browser storage.</p></form>
  <p data-admin-status class="admin-message" role="status" aria-live="polite"></p>
  <div data-admin-area hidden>
   <nav class="admin-tabs" aria-label="Workbench sections"><a href="#review">Review queue</a><a href="#content">Listings</a><a href="#delivery">Delivery</a><a href="#corrections">Corrections</a><a href="#collections">Collections</a><a href="#operations">Operations</a><button type="button" class="btn btn-quiet" data-admin-logout>Sign out</button></nav>
   <section id="review"><h2>Review pending submissions</h2><div class="admin-grid"><div data-review-queue></div>
    <form class="admin-editor" data-review-editor hidden><h3 data-review-name></h3><p data-maker-wish></p><label>Published slug<input name="slug" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" /></label><label>Project name<input name="name" required maxlength="80" /></label><label>Submitted homepage<input name="url" type="url" readonly /></label><label>Category<select name="category">{Object.entries(CATEGORY_NAMES).map(([value,label])=><option value={value}>{label}</option>)}</select></label><label>Pricing<select name="pricing"><option value="free">Free</option><option value="freemium">Freemium</option><option value="paid">Paid</option><option value="open-source">Open source</option></select></label><label>Summary<textarea name="summary" required minlength="40" maxlength="160" rows="3" /></label><label>Full description<textarea name="description" required minlength="300" maxlength="12000" rows="8" /></label><label>Tags (comma separated)<input name="tags" required maxlength="400" /></label><label>Short blessing<input name="blessingShort" required maxlength="120" /></label><label>Full blessing<textarea name="blessingLong" required minlength="120" maxlength="600" rows="6" /></label><label><input name="blessingApproved" type="checkbox" required /> I have edited and confirmed this blessing for the maker.</label><p class="section-intro">Publishing uses today's allowance in UTC. The official link starts as nofollow until a signed verification check succeeds.</p><div class="product-actions"><button type="submit" class="btn btn-primary">Publish reviewed project</button><button type="button" class="btn btn-quiet" data-review-reject>Reject submission</button><button type="button" class="btn btn-quiet" data-review-close>Close editor</button></div></form>
   </div></section>
   <section id="content" class="section"><h2>Published and retained listings</h2><div class="admin-grid"><div><div data-content-list></div><button class="btn btn-quiet" data-content-more type="button" hidden>Load more listings</button></div><form data-content-editor class="admin-editor" hidden><h3 data-content-name></h3><label>Listing fields<textarea name="content" rows="22" spellcheck="false" required /></label><p class="section-intro">The editor keeps the loaded version. If another review changes the listing, reload it before saving.</p><button type="submit" class="btn btn-primary">Save listing changes</button></form><form data-alias-editor class="admin-editor" hidden><h3>Record another reviewed identity</h3><label>Related public homepage<input name="url" type="url" required /></label><label>Review reason<textarea name="reason" required minlength="20" maxlength="1000" rows="3" /></label><button class="btn btn-quiet" type="submit">Save identity alias</button><ul data-alias-list></ul></form></div></section>
   <section id="delivery" class="section"><h2>Service notification delivery</h2><p class="section-intro">Accepted means the email provider accepted the message. It does not confirm inbox delivery.</p><button class="btn btn-quiet" type="button" data-dispatch>Dispatch queued messages</button><div data-delivery-list></div></section>
   <section id="corrections" class="section"><h2>Correction requests</h2><div data-correction-list></div></section>
   <section id="collections" class="section"><h2>Thematic collections</h2><div data-collection-list></div><form class="admin-editor" data-collection-editor><label>Collection slug<input name="slug" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" /></label><label>Title<input name="title" required maxlength="100" /></label><label>Description<textarea name="description" required maxlength="600" rows="3" /></label><label>Public project slugs (comma separated, up to 24)<input name="slugs" required maxlength="2400" /></label><label><input type="checkbox" name="approved" /> Publish collection</label><button type="submit" class="btn btn-primary">Save collection</button></form></section>
   <section id="operations" class="section"><h2>Operations snapshot</h2><button class="btn btn-quiet" type="button" data-refresh>Refresh workbench</button><pre class="admin-metrics" data-admin-metrics></pre></section>
  </div>
 </section>
 <script is:inline type="module" src="/admin.js"></script>
</Base>
