---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { loadCatalog } from '../lib/catalog.mjs';
import { SITE } from '../lib/site.ts';

const { categories } = loadCatalog();
const status = new URL(Astro.request.url).searchParams.get('status');
const title = `Share your AI product wish | ${SITE.name}`;
const description = `Bring your AI product into the WishMeteor sky. Share what you are building, receive a personal blessing, and let the community help your launch shine.`;
---

<Base title={title} description={description}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Make a wish' }]} />
  <div class="page-head">
    <p class="eyebrow">Free, forever</p>
    <h1>Make a wish</h1>
    <p class="lede">
      Tell us what you are building and why it matters to you. If your wish clears review, we will give it a place in the sky
      and send a personal blessing to your inbox, along with a card you can share.
    </p>
  </div>

  {
    status === 'queued' && (
      <p class="notice" role="status">
        Your wish found its way to us. We will review it with care and send a note when it is ready to shine.
      </p>
    )
  }
  {
    status === 'duplicate' && (
      <p class="notice" role="status">
        That domain is already on the wall or already in the queue. One wish per product, please.
      </p>
    )
  }
  {
    status === 'throttled' && (
      <p class="notice" role="status">
        We have received a few wishes from this address recently. Please give the sky a little time, then try again.
      </p>
    )
  }
  {
    status === 'rejected' && (
      <p class="notice" role="status">
        That link did not pass the checks — it was unreachable, off-topic, or looked like a link farm. Fix the page and wish
        again in a week.
      </p>
    )
  }

  <div class="split">
    <div>
      <form method="post" action="/api/submit" class="form-grid">
        <div>
          <label for="name">Product name</label>
          <input id="name" name="name" required maxlength="80" placeholder="What should the index call it?" />
        </div>
        <div>
          <label for="url">Link</label>
          <input id="url" name="url" type="url" required placeholder="https://yourproduct.com" />
          <p class="hint">The homepage, not a affiliate or tracking link. We canonicalise it and drop parameters.</p>
        </div>
        <div>
          <label for="email">Email for your blessing</label>
          <input id="email" name="email" type="email" required placeholder="you@yourproduct.com" />
          <p class="hint">
            Used once, to send the blessing and the card. Never published, never added to a list, deleted whenever you ask.
          </p>
        </div>
        <div>
          <label for="category">Category</label>
          <select id="category" name="category" required>
            {categories.map((category) => <option value={category.id}>{category.name}</option>)}
          </select>
        </div>
        <div>
          <label for="notes">What it does, in your own words</label>
          <textarea id="notes" name="notes" rows="5" maxlength="600" placeholder="Who is it for, and what does it make possible?"></textarea>
          <p class="hint">Write from the heart. Tell us what led you to build it and the people you hope it will help.</p>
        </div>
        <div>
          <label for="make-a-wish">Make a wish <span class="hint">Optional</span></label>
          <textarea id="make-a-wish" name="makeAWish" rows="3" maxlength="320" placeholder="What are you hoping this project will make possible?"></textarea>
          <p class="hint">Share a hope or intention connected to your project. It will be reviewed with your submission.</p>
        </div>
        <div class="hp-field" aria-hidden="true">
          <label for="company">Company<input id="company" name="hp" tabindex="-1" autocomplete="off" /></label>
        </div>
        <div>
          <label style="font-weight:400">
            <input type="checkbox" name="own" value="yes" required style="width:auto;margin-right:.5rem" />
            I own this domain or I am allowed to submit it, and I understand links here are reviewed and can be taken down.
          </label>
        </div>
        <div>
          <button class="btn btn-primary" type="submit">Send the wish</button>
        </div>
      </form>
    </div>

    <div class="aside-sticky">
      <section class="aside-box" aria-labelledby="rules">
        <h2 id="rules">The rules, out loud</h2>
        <ul style="padding-left:1.1rem;font-size:.92rem">
          <li>Every wish is reviewed before it joins the sky.</li>
          <li>Keep your product available and its description honest so its light stays clear.</li>
          <li>There is no fee, upgrade, or reciprocity requirement.</li>
          <li>Not accepted: casinos, crypto giveaways, cloned wrappers, link farms, anything that requires a login to evaluate.</li>
        </ul>
        <p style="font-size:.9rem;margin-bottom:0">
          The long version is on the <a href="/dofollow-policy">link policy</a> page.
        </p>
      </section>
    </div>
  </div>
</Base>
