---
import { outboundRel } from '../lib/links.mjs';

interface Props {
  entry: any;
  class?: string;
  /** Render the product name as the link text. */
  label?: string;
}

const { entry, class: className, label } = Astro.props;
const rel = outboundRel(entry);
---

<a
  class={className}
  href={entry.url}
  target="_blank"
  rel={rel}
  title={`Visit ${entry.name}`}>{label ?? entry.name}</a
>
