---
interface Props {
  entries: any[];
  title?: string;
}

const { entries, title = 'A sky full of wishes' } = Astro.props;
---

<section class="section wish-wall-section" aria-labelledby="wish-wall" id="wish-wall">
  <div class="section-head">
    <div><p class="eyebrow">A little light goes a long way</p><h2 id="wish-wall">{title}</h2><p class="section-intro">Every star is a small act of encouragement. Light one for a launch you hope to see flourish.</p></div>
    <a class="text-link" href="/new">Visit the wish sky <span aria-hidden="true">↗</span></a>
  </div>
  {
    entries.length === 0 ? (
      <div class="empty-sky"><span aria-hidden="true">✦</span><div><h3>The sky is waiting for its first wish.</h3><p>Bring your idea here. We will give it a place to shine and a blessing to carry forward.</p><a class="text-link" href="/submit">Share the first wish <span aria-hidden="true">↗</span></a></div></div>
    ) : (
      <div class="wish-wall" data-wish-wall>
        {entries.map((entry, index) => (
          <article class="wish-card" data-slug={entry.slug} data-rank={index}>
            <span class="wish-card__index">{String(index + 1).padStart(2, '0')}</span>
            <div class="wish-card__body">
              <p class="wish-card__date">{entry.wish ? `A wish sent into the sky · ${entry.wish.submittedAt}` : 'A thoughtful project, gathered under this sky'}</p>
              <h3><a href={`/tool/${entry.slug}`}>{entry.name}</a></h3>
              <p class="wish-card__blessing">&ldquo;{entry.wish?.blessingShort ?? entry.summary}&rdquo;</p>
              <a class="wish-card__more" href={`/tool/${entry.slug}`}>Read the story <span aria-hidden="true">↗</span></a>
            </div>
            <button class="star-vote" type="button" data-star-button aria-label={`Light a star for ${entry.name}`} aria-pressed="false">
              <span class="star-vote__icon" aria-hidden="true">✦</span><span class="star-vote__count" data-star-count>—</span><span class="star-vote__label" data-star-label>Light a star</span>
            </button>
          </article>
        ))}
      </div>
    )
  }
  <p class="wish-wall__note" data-star-status role="status" aria-live="polite">One encouragement per wish for this browser identity. Browser stars are not a count of people.</p>
</section>
