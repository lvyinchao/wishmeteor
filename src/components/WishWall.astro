---
interface Props {
  entries: any[];
  title?: string;
}

const { entries, title = 'A sky full of wishes' } = Astro.props;
---

<section class="section wish-wall-section" aria-labelledby="wish-wall" id="wish-wall">
  <div class="section-head">
    <div><p class="eyebrow">A little light goes a long way</p><h2 id="wish-wall">{title}</h2><p class="section-intro">Every star is a small act of encouragement. Light one for a launch you hope to see flourish.</p></div>
    <a class="text-link" href="/new">Visit the wish sky <span aria-hidden="true">↗</span></a>
  </div>
  {
    entries.length === 0 ? (
      <div class="empty-sky"><span aria-hidden="true">✦</span><div><h3>The sky is waiting for its first wish.</h3><p>Bring your idea here. We will give it a place to shine and a blessing to carry forward.</p><a class="text-link" href="/submit">Share the first wish <span aria-hidden="true">↗</span></a></div></div>
    ) : (
      <div class="wish-wall" data-wish-wall>
        {entries.map((entry, index) => (
          <article class="wish-card" data-slug={entry.slug} data-rank={index}>
            <span class="wish-card__index">{String(index + 1).padStart(2, '0')}</span>
            <div class="wish-card__body">
              <p class="wish-card__date">{entry.wish ? `A wish sent into the sky · ${entry.wish.submittedAt}` : 'A thoughtful project, gathered under this sky'}</p>
              <h3><a href={`/tool/${entry.slug}`}>{entry.name}</a></h3>
              <p class="wish-card__blessing">&ldquo;{entry.wish?.blessingShort ?? entry.summary}&rdquo;</p>
              <a class="wish-card__more" href={`/tool/${entry.slug}`}>Read the story <span aria-hidden="true">↗</span></a>
            </div>
            <button class="star-vote" type="button" data-star-button aria-label={`Light a star for ${entry.name}`} aria-pressed="false">
              <span class="star-vote__icon" aria-hidden="true">✦</span><span class="star-vote__count" data-star-count>—</span><span class="star-vote__label" data-star-label>Light a star</span>
            </button>
          </article>
        ))}
      </div>
    )
  }
  <p class="wish-wall__note" data-star-status role="status" aria-live="polite">Each person can light one star for a wish. The brightest wishes find their way upward.</p>
</section>

<script>
  type StarData = { counts: Record<string, number> };
  const makeVoterId = () => {
    try {
      let id = localStorage.getItem('wishmeteor:voter');
      if (!id) { id = crypto.randomUUID(); localStorage.setItem('wishmeteor:voter', id); }
      return id;
    } catch { return ''; }
  };

  document.querySelectorAll<HTMLElement>('[data-wish-wall]').forEach((wall) => {
    const cards = [...wall.querySelectorAll<HTMLElement>('.wish-card')];
    const counts = new Map<string, number>();
    const storageKey = (slug: string) => `wishmeteor:star:${slug}`;
    const arrange = () => cards.sort((a, b) => (counts.get(b.dataset.slug ?? '') ?? 0) - (counts.get(a.dataset.slug ?? '') ?? 0) || Number(a.dataset.rank) - Number(b.dataset.rank)).forEach((card) => wall.append(card));

    const hydrate = async () => {
      try {
        const slugs = cards.map((card) => card.dataset.slug).filter(Boolean).join(',');
        const response = await fetch(`/api/stars?slugs=${encodeURIComponent(slugs)}`);
        if (!response.ok) throw new Error('Stars could not be loaded');
        const data = await response.json() as StarData;
        for (const card of cards) {
          const slug = card.dataset.slug ?? '';
          const count = data.counts?.[slug] ?? 0;
          counts.set(slug, count);
          card.querySelector<HTMLElement>('[data-star-count]')!.textContent = String(count);
          const button = card.querySelector<HTMLButtonElement>('[data-star-button]')!;
          if (localStorage.getItem(storageKey(slug))) {
            button.setAttribute('aria-pressed', 'true'); button.disabled = true;
            button.querySelector<HTMLElement>('[data-star-label]')!.textContent = 'Your star is lit';
          }
        }
        arrange();
      } catch {
        for (const card of cards) card.querySelector<HTMLElement>('[data-star-count]')!.textContent = '☆';
      }
    };

    cards.forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('[data-star-button]')!;
      button.addEventListener('click', async () => {
        const slug = card.dataset.slug ?? '';
        const voter = makeVoterId();
        if (!voter) {
          wall.parentElement?.querySelector<HTMLElement>('[data-star-status]') && (wall.parentElement.querySelector<HTMLElement>('[data-star-status]')!.textContent = 'Your browser storage is unavailable, so we could not save your star.');
          return;
        }
        button.disabled = true;
        try {
          const response = await fetch('/api/stars', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ slug, voter }) });
          if (!response.ok) throw new Error('Star could not be saved');
          const result = await response.json() as { count: number; alreadyLit?: boolean };
          counts.set(slug, result.count);
          localStorage.setItem(storageKey(slug), '1');
          button.setAttribute('aria-pressed', 'true');
          button.querySelector<HTMLElement>('[data-star-count]')!.textContent = String(result.count);
          button.querySelector<HTMLElement>('[data-star-label]')!.textContent = 'Your star is lit';
          if (!result.alreadyLit) card.classList.add('wish-card--celebrate');
          arrange();
        } catch {
          button.disabled = false;
          const status = wall.parentElement?.querySelector<HTMLElement>('[data-star-status]');
          if (status) status.textContent = 'Your star did not reach the sky. Please try again in a moment.';
        }
      });
    });
    void hydrate();
  });
</script>
