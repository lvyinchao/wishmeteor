---
import MeteorMark from './MeteorMark.astro';
import { SITE } from '../lib/site.ts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const nav = [
  { href: '/new', label: 'Wish sky' },
  { href: '/tools', label: 'Explore ideas' },
  { href: '/about', label: 'Our story' },
];
---

<header class="site-header">
  <div class="shell">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <MeteorMark />
      <span>{SITE.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {nav.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
      <a href="/account" aria-current={isActive('/account') ? 'page' : undefined}>Sign in</a>
      <a class="btn btn-primary" href="/submit">Make a wish</a>
    </nav>
  </div>
</header>
