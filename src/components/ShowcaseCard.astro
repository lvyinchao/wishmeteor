---
import { productCoverSources,productCoverLabel } from '../lib/product-covers';
import { outboundRel } from '../lib/link-policy';
interface Props { entry: any; categoryName: string; stars?: boolean; }
const { entry, categoryName, stars = true } = Astro.props;
const wish = entry.wish && typeof entry.wish === 'object' ? entry.wish : {};
const excerpt = typeof wish.makerWish === 'string' && wish.makerWish.trim() ? wish.makerWish.trim() : entry.summary;
const cover = entry.coverImage ?? `/tool-previews/${entry.slug}.jpg`;
const uploaded=cover.startsWith('/api/product-screenshots/');
const coverSource=uploaded?undefined:productCoverSources[entry.slug];
---
<article class="card tool-showcase-card" data-catalog-item data-slug={entry.slug} data-category={entry.category} data-search={`${entry.name} ${excerpt} ${categoryName} ${(entry.tags ?? []).join(' ')}`.toLowerCase()}>
  <a class="tool-showcase-card__preview" href={`/tool/${entry.slug}`}><img class:list={{'product-interface-cover':!!coverSource||uploaded}} src={cover} alt={`${uploaded?'Submitted product screenshot':coverSource?productCoverLabel(coverSource):'Product cover'} for ${entry.name}`} loading="lazy" decoding="async" /></a>
  <div class="tool-showcase-card__content">
    <h3><a class="card-title" href={`/tool/${entry.slug}`}>{entry.name}</a></h3>
    <p>{excerpt}</p>
    <div class="card-meta"><span class="pill">{categoryName}</span><span class="pill">{entry.pricing}</span><a class="pill" href={entry.url} rel={outboundRel(entry)} target="_blank">Visit project ↗</a></div>
    {stars && <button class="star-vote" type="button" data-star-button aria-label={`Light a star for ${entry.name}`} aria-pressed="false"><span class="star-vote__icon" aria-hidden="true">✦</span><span class="star-vote__count" data-star-count>—</span><span class="star-vote__label" data-star-label>Light a star</span></button>}
  </div>
</article>
