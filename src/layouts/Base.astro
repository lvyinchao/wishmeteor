---
import { publicHead,publicHeader,publicFooter,publicScripts } from '../lib/public-shell.ts';
interface Props {
 title:string; description:string; image?:string; imageAlt?:string; type?:'website'|'article';
 publishedTime?:string; modifiedTime?:string; noindex?:boolean; jsonLd?:object[];
}
const head=publicHead({...Astro.props,path:Astro.url.pathname});
const privatePage=Astro.props.noindex===true || Astro.url.searchParams.has('reset');
---
<!doctype html>
<html lang="en">
 <head><Fragment set:html={head}/></head>
 <body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Fragment set:html={publicHeader(Astro.url.pathname)}/>
  <main id="main" class="shell"><slot/></main>
  <Fragment set:html={publicFooter()}/>
  <Fragment set:html={publicScripts(import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? 'G-QV8KGLLDXR',privatePage)}/>
 </body>
</html>
