---
import SEOHead from '../components/SEOHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const { jsonLd = [], ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="WishMeteor blog" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <SEOHead {...head} />
    {jsonLd.map((block) => <JsonLd data={block} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="shell">
      <slot />
    </main>
    <SiteFooter />
    <AnalyticsConsent measurementId={import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? ''} />
  </body>
</html>
