{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishmeteor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-07",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [
    { "pattern": "wishmeteor.net/*", "zone_name": "wishmeteor.net" },
    { "pattern": "www.wishmeteor.net/*", "zone_name": "wishmeteor.net" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishmeteor",
      "database_id": "6217d5cf-0d16-45e0-9b77-4408187bf400"
    }
  ]
}
