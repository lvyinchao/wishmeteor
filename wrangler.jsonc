{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishmeteor",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/new", "/new/*", "/tools", "/tools/*", "/tool/*", "/category/*", "/compare", "/collections", "/collections/*", "/updates", "/rss.xml", "/sitemap.xml", "/sitemap-pages.xml", "/sitemap-tools.xml", "/sitemap-tools-*.xml"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "rules": [{"type":"Data","globs":["**/*.ttf"],"fallthrough":true}],
  "routes": [
    { "pattern": "wishmeteor.net/*", "zone_name": "wishmeteor.net" },
    { "pattern": "www.wishmeteor.net/*", "zone_name": "wishmeteor.net" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://wishmeteor.net"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["support@wishmeteor.net"]
    }
  ],
  "r2_buckets": [{ "binding": "PRODUCT_SCREENSHOTS", "bucket_name": "wishmeteor-product-screenshots" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wishmeteor",
      "database_id": "6217d5cf-0d16-45e0-9b77-4408187bf400"
    }
  ]
}
