{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishmeteor",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "routes": [
    { "pattern": "wishmeteor.net/*", "zone_name": "wishmeteor.net" },
    { "pattern": "www.wishmeteor.net/*", "zone_name": "wishmeteor.net" }
  ],
  "vars": { "APP_URL": "https://wishmeteor.net" },
  "d1_databases": [{ "binding": "DB", "database_name": "wishmeteor", "database_id": "6217d5cf-0d16-45e0-9b77-4408187bf400" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wishmeteor-media" }],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "3f8e4dd5185143e2866a6d926c758df6" },
    { "binding": "SESSION", "id": "353ccb112cc4460da75bb73a3d82509a" }
  ],
  "queues": {
    "producers": [{ "binding": "CARD_GENERATION_QUEUE", "queue": "wishmeteor-card-generation" }],
    "consumers": [{ "queue": "wishmeteor-card-generation", "max_batch_size": 1, "max_retries": 2, "max_concurrency": 1 }]
  }
}
